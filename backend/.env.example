# ─── Supabase ───────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# ─── JWT (generate a strong random secret) ──────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ─── Groq AI (open-source models) ───────────────────────────
# Free tier at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.3-70b-versatile

# ─── Stripe ─────────────────────────────────────────────────
# Found in: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── CORS (comma-separated allowed origins) ─────────────────
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.pages.dev
